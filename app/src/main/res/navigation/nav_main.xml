<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/notesListFragment">

    <fragment
        android:id="@+id/notesListFragment"
        android:name="com.khatawat.diyn.ui.notes.NotesListFragment"
        android:label="@string/notes_title"
        tools:layout="@layout/fragment_list"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_notes_to_edit"
            app:destination="@id/noteEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/noteEditFragment"
        android:name="com.khatawat.diyn.ui.notes.NoteEditFragment"
        tools:layout="@layout/fragment_note_edit"
        xmlns:tools="http://schemas.android.com/tools">
        <argument
            android:name="noteId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

    <fragment
        android:id="@+id/debtsListFragment"
        android:name="com.khatawat.diyn.ui.debts.DebtsListFragment"
        android:label="@string/debts_title"
        tools:layout="@layout/fragment_list"
        xmlns:tools="http://schemas.android.com/tools">
        <action
            android:id="@+id/action_debts_to_edit"
            app:destination="@id/debtEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/debtEditFragment"
        android:name="com.khatawat.diyn.ui.debts.DebtEditFragment"
        tools:layout="@layout/fragment_debt_edit"
        xmlns:tools="http://schemas.android.com/tools">
        <argument
            android:name="debtId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.khatawat.diyn.ui.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings"
        xmlns:tools="http://schemas.android.com/tools" />
</navigation>
